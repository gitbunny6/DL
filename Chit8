
# CHIT 8: Implement Recurrent Neural Network using NumPy

# 1. Import NumPy
import numpy as np

# 2. Define input sequence
X = np.array([
    [1, 0],
    [0, 1],
    [1, 1]
])

# 3. Initialize weights and bias
np.random.seed(42)

input_size = 2
hidden_size = 3
output_size = 2

Wx = np.random.rand(input_size, hidden_size)
Wh = np.random.rand(hidden_size, hidden_size)
Wy = np.random.rand(hidden_size, output_size)

bh = np.zeros((1, hidden_size))
by = np.zeros((1, output_size))

# 4. Initialize hidden state
h = np.zeros((1, hidden_size))

# 5. RNN forward propagation
for t in range(len(X)):

    xt = X[t].reshape(1, -1)

    h = np.tanh(np.dot(xt, Wx) + np.dot(h, Wh) + bh)

    y = np.dot(h, Wy) + by

    print("Time Step:", t + 1)
    print("Hidden State:", h)
    print("Output:", y)
    print()

print("RNN execution completed.")
